<launch>
  <arg name="map_size_x" value="40.0"/>
  <arg name="map_size_y" value="40.0"/>
  <arg name="map_size_z" value="5.0"/>

  <arg name="drone_num" value="3" />

  <include file="$(find exploration_manager)/launch/single_search.launch">
    <arg name="drone_id" value="1"/>
    <arg name="init_x"   value="6.0"/>
    <arg name="init_y"   value="8.0"/>
    <arg name="init_z"   value="1.0"/> 
    <arg name="map_size_x" value="$(arg map_size_x)"/>
    <arg name="map_size_y" value="$(arg map_size_y)"/>
    <arg name="map_size_z" value="$(arg map_size_z)"/>
    <arg name="drone_num" value="$(arg drone_num)"/>
  </include>

  <include file="$(find exploration_manager)/launch/single_search.launch">
      <arg name="drone_id" value="2"/>
      <arg name="init_x"   value="10.0"/>
      <arg name="init_y"   value="8.0"/>
      <arg name="init_z"   value="1.0"/> 
      <arg name="map_size_x" value="$(arg map_size_x)"/>
      <arg name="map_size_y" value="$(arg map_size_y)"/>
      <arg name="map_size_z" value="$(arg map_size_z)"/>
      <arg name="drone_num" value="$(arg drone_num)"/>
  </include>

</launch>
